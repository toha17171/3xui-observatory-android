<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_compact_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg"
    android:paddingLeft="13dp" android:paddingRight="13dp"
    android:paddingTop="9dp" android:paddingBottom="9dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_compact_title" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:text="3x-ui" android:textSize="14sp" android:textStyle="bold"
            android:textColor="#F5F6FA" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/w_compact_refresh" android:layout_width="30dp"
            android:layout_height="30dp" android:gravity="center"
            android:text="↻" android:textSize="20sp" android:textColor="#1677FF"
            android:contentDescription="Обновить данные"/>
        <TextView android:id="@+id/w_compact_settings" android:layout_width="26dp"
            android:layout_height="30dp" android:gravity="center"
            android:text="⚙" android:textSize="16sp" android:textColor="#B0B4BF"
            android:contentDescription="Настроить виджет"/>
    </LinearLayout>
    <TextView android:id="@+id/w_compact_primary" android:layout_width="match_parent"
        android:layout_height="22dp" android:text="OBSERVATORY"
        android:gravity="center_vertical" android:textSize="12sp" android:textStyle="bold"
        android:textColor="#82B6FF" android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/w_compact_line1" android:layout_width="match_parent"
        android:layout_height="21dp" android:text="● Outbound —"
        android:gravity="center_vertical" android:textSize="12sp"
        android:textColor="#EDF0F5" android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/w_compact_line2" android:layout_width="match_parent"
        android:layout_height="21dp" android:text="● Outbound —"
        android:gravity="center_vertical" android:textSize="12sp"
        android:textColor="#EDF0F5" android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/w_compact_footer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:minHeight="15dp"
        android:gravity="center_vertical" android:text="Обновление…"
        android:textSize="10sp" android:textColor="#9FA8B8"
        android:singleLine="true" android:ellipsize="end"/>
</LinearLayout>