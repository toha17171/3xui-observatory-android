<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_large_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg"
    android:paddingLeft="14dp" android:paddingRight="14dp"
    android:paddingTop="10dp" android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_large_title" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:text="3x-ui Observatory" android:textStyle="bold" android:textSize="16sp"
            android:textColor="#F4F6FA" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/w_large_refresh" android:layout_width="32dp"
            android:layout_height="32dp" android:gravity="center"
            android:text="↻" android:textSize="22sp" android:textColor="#1677FF"
            android:contentDescription="Обновить данные"/>
        <TextView android:id="@+id/w_large_settings" android:layout_width="28dp"
            android:layout_height="32dp" android:gravity="center"
            android:text="⚙" android:textSize="17sp" android:textColor="#B0B4BF"
            android:contentDescription="Настроить виджет"/>
    </LinearLayout>
    <TextView android:id="@+id/w_large_summary"
        android:layout_width="match_parent" android:layout_height="24dp"
        android:text="OBSERVATORY · —"
        android:textSize="12sp" android:textStyle="bold" android:textColor="#86B9FF"
        android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/w_large_line1" style="@style/ObservatoryWidgetRow"/>
    <TextView android:id="@+id/w_large_line2" style="@style/ObservatoryWidgetRow"/>
    <TextView android:id="@+id/w_large_line3" style="@style/ObservatoryWidgetRow"/>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#363B45" android:layout_marginTop="3dp"
        android:layout_marginBottom="4dp"/>
    <TextView android:id="@+id/w_large_chart_title"
        android:layout_width="match_parent" android:layout_height="20dp"
        android:text="ЗАДЕРЖКА · мс" android:textSize="11sp" android:textStyle="bold"
        android:textColor="#B1B9C6" android:singleLine="true" android:ellipsize="end"
        android:gravity="center_vertical"/>
    <ImageView android:id="@+id/w_large_chart" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:minHeight="52dp" android:scaleType="fitXY"
        android:contentDescription="История выбранной метрики"/>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#363B45" android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"/>
    <TextView android:id="@+id/w_large_totals" android:layout_width="match_parent"
        android:layout_height="21dp" android:textSize="11sp"
        android:textColor="#E0E4EA" android:singleLine="true" android:ellipsize="end"
        android:gravity="center_vertical"/>
    <TextView android:id="@+id/w_large_footer" android:layout_width="match_parent"
        android:layout_height="16dp" android:text="Обновлено —"
        android:textSize="10sp" android:textColor="#9DA6B6"
        android:singleLine="true" android:ellipsize="end"
        android:gravity="center_vertical"/>
</LinearLayout>