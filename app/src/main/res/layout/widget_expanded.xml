<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_large_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:padding="13dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_large_title" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content"
            android:text="3x-ui" android:textColor="#FAFAFB" android:textStyle="bold"
            android:textSize="17sp" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/w_large_refresh" android:layout_width="32dp"
            android:layout_height="32dp" android:text="↻" android:gravity="center"
            android:textSize="23sp" android:textColor="#1677FF"
            android:contentDescription="Обновить"/>
        <TextView android:id="@+id/w_large_settings" android:layout_width="30dp"
            android:layout_height="32dp" android:text="⚙" android:gravity="center"
            android:textSize="18sp" android:textColor="#A3A7B2"
            android:contentDescription="Настроить виджет"/>
    </LinearLayout>
    <TextView android:id="@+id/w_large_summary" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="INBOUND · —"
        android:textSize="12sp" android:textStyle="bold" android:textColor="#A3A7B2"
        android:paddingTop="5dp"/>
    <TextView android:id="@+id/w_large_totals" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="↓ —    ↑ —"
        android:textSize="19sp" android:textStyle="bold" android:textColor="#F5F7FC"
        android:paddingTop="4dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ИСТОРИЯ ТРАФИКА   ● DOWN      ● UP" android:textSize="10sp"
        android:textColor="#83C5FF" android:paddingTop="7dp"/>
    <ImageView android:id="@+id/w_large_chart" android:layout_width="match_parent"
        android:layout_height="105dp" android:scaleType="fitXY"
        android:contentDescription="График трафика выбранных inbound"/>
    <TextView android:id="@+id/w_large_line1" style="@style/WidgetInboundRow"/>
    <TextView android:id="@+id/w_large_line2" style="@style/WidgetInboundRow"/>
    <TextView android:id="@+id/w_large_line3" style="@style/WidgetInboundRow"/>
    <TextView android:id="@+id/w_large_more" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#A3A7B2"
        android:textSize="10sp"/>
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#373A42" android:layout_marginTop="6dp"
        android:layout_marginBottom="5dp"/>
    <TextView android:id="@+id/w_large_outbound" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="OUTBOUND · —"
        android:textSize="11sp" android:textColor="#82CAFF"
        android:singleLine="true" android:ellipsize="end"/>
    <TextView android:id="@+id/w_large_footer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Нет обновлений"
        android:textSize="10sp" android:textColor="#A3A7B2"
        android:paddingTop="6dp"/>
</LinearLayout>